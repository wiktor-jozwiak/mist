pkgbase = mist-shell-git
	pkgdesc = macOS-inspired desktop shell for Hyprland, written in Rust and drawn on the CPU
	pkgver = r0
	pkgrel = 1
	url = https://github.com/wiktor-jozwiak/mist
	arch = x86_64
	license = GPL-3.0-only
	makedepends = git
	makedepends = rust
	makedepends = pkgconf
	depends = hyprland
	depends = wayland
	depends = libxkbcommon
	depends = mesa
	depends = pam
	depends = libinput
	depends = seatd
	depends = libdrm
	depends = systemd-libs
	depends = pipewire-pulse
	depends = wireplumber
	depends = wl-clipboard
	depends = grim
	depends = slurp
	depends = xdg-utils
	depends = xdg-user-dirs
	optdepends = inter-font: UI font when SF Pro is not installed
	optdepends = noto-fonts-emoji: emoji picker
	optdepends = networkmanager: network status and Wi-Fi list
	optdepends = bluez-utils: Bluetooth
	optdepends = kdeconnect: phone integration
	optdepends = android-tools: phone screen, calls and more over ADB
	optdepends = scrcpy: phone screen on the PC
	optdepends = mpv: Mist Player (libmpv)
	optdepends = docker: Garmin cards (see docs/guides/garmin.md)
	provides = mist-shell
	conflicts = mist-shell
	source = mist::git+https://github.com/wiktor-jozwiak/mist.git
	sha256sums = SKIP

pkgname = mist-shell-git
