# Maintainer: Wiktor Józwiak <wjozwiak92 at gmail dot com>
# Mist from git: mist-ui (bar, dock, island, desktop, panels), mist-wall (live wallpapers), mistd (backends),
# mist-comp (experimental compositor). Files go to /usr/share/mist, which common/paths.rs looks up.
pkgname=mist-shell-git
pkgver=r0
pkgrel=1
pkgdesc="macOS-inspired desktop shell for Hyprland, written in Rust and drawn on the CPU"
arch=('x86_64')
url="https://github.com/wiktor-jozwiak/mist"
license=('GPL-3.0-only')
depends=('hyprland' 'wayland' 'libxkbcommon' 'mesa' 'pam' 'libinput' 'seatd' 'libdrm' 'systemd-libs'
         'pipewire-pulse' 'wireplumber' 'wl-clipboard' 'grim' 'slurp' 'xdg-utils' 'xdg-user-dirs')
makedepends=('git' 'rust' 'pkgconf')
optdepends=('inter-font: UI font when SF Pro is not installed'
            'noto-fonts-emoji: emoji picker'
            'networkmanager: network status and Wi-Fi list'
            'bluez-utils: Bluetooth'
            'kdeconnect: phone integration'
            'android-tools: phone screen, calls and more over ADB'
            'scrcpy: phone screen on the PC'
            'mpv: Mist Player (libmpv)'
            'docker: Garmin cards (see docs/guides/garmin.md)'
            'xdg-desktop-portal-hyprland: screen sharing and screenshots in the Mist session'
            'xorg-xwayland: X11 apps in the Mist session')
provides=('mist-shell')
conflicts=('mist-shell')
source=("mist::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd mist
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    # native/.cargo/config.toml builds for the author's CPU: a package builds for any x86-64
    export RUSTFLAGS="" CARGO_BUILD_RUSTFLAGS=""
    cd mist/native
    cargo build --release --locked
    cd ../scripts/mistd
    cargo build --release --locked
}

check() {
    export RUSTFLAGS="" CARGO_BUILD_RUSTFLAGS=""
    cd mist/native
    cargo test --release --locked -p mist-ui
}

package() {
    cd mist
    install -Dm755 native/target/release/mist-ui "$pkgdir/usr/bin/mist-ui-bin"
    install -Dm755 native/target/release/mist-wall "$pkgdir/usr/bin/mist-wall-bin"
    install -Dm755 native/target/release/mist-comp "$pkgdir/usr/bin/mist-comp"
    install -Dm755 scripts/mistd/target/release/mistd "$pkgdir/usr/bin/mistd"
    install -Dm755 native/dist/mist-ui "$pkgdir/usr/bin/mist-ui"

    local share="$pkgdir/usr/share/mist"
    install -d "$share/native" "$share/scripts" "$share/shaders" "$share/examples"
    cp -r native/assets "$share/native/"
    install -m755 scripts/*.sh "$share/scripts/"
    install -m644 shaders/*.glsl "$share/shaders/"
    cp -r shaders/glsl "$share/shaders/"
    cp -r examples/hyprland "$share/examples/"
    cp -r docs "$share/"
    # the Mist session (mist-comp on its own, next to Hyprland in the login manager): start-mist finds
    # /usr/bin/mist-comp and installs its portal config (screen sharing) per user at login
    install -d "$share/native/mist-comp/session"
    install -m755 native/mist-comp/session/start-mist native/mist-comp/session/mist-session "$share/native/mist-comp/session/"
    install -m644 native/mist-comp/session/mist-portals.conf "$share/native/mist-comp/session/"
    install -Dm644 packaging/mist.desktop "$pkgdir/usr/share/wayland-sessions/mist.desktop"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 NOTICE.md "$pkgdir/usr/share/licenses/$pkgname/NOTICE.md"
    install -Dm644 native/assets/LICENSE.noctalia "$pkgdir/usr/share/licenses/$pkgname/LICENSE.noctalia"
}
